# Production Environment Configuration (External Managed Database & Redis)
# Replace placeholders with your managed cloud provider credentials (e.g. AWS RDS/Supabase, Upstash/Redis Cloud).

DATABASE_URL="postgresql://prod_user:prod_secure_password@your-db-host.rds.amazonaws.com:5432/socialhub_prod?sslmode=require"
REDIS_URL="rediss://default:prod_redis_password@your-redis-host.upstash.io:6379"
REDIS_TLS=true
REDIS_TLS_REJECT_UNAUTHORIZED=true
RUN_MIGRATIONS=true

PORT=5000
CLIENT_URL="https://socialhub.yourdomain.com"

NEXT_PUBLIC_API_URL="https://api.socialhub.yourdomain.com/graphql"
NEXT_PUBLIC_WS_URL="wss://api.socialhub.yourdomain.com/graphql"
NEXT_PUBLIC_API_BASE_URL="https://api.socialhub.yourdomain.com"

ACCESS_TOKEN_SECRET="generate_at_least_32_characters_random_secret_here"
REFRESH_TOKEN_SECRET="generate_at_least_32_characters_random_secret_here"

GOOGLE_CLIENT_ID="your_production_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_production_google_client_secret"
GOOGLE_REDIRECT_URL="https://api.socialhub.yourdomain.com/auth/google/callback"

GITHUB_CLIENT_ID="your_production_github_client_id"
GITHUB_CLIENT_SECRET="your_production_github_client_secret"
GITHUB_REDIRECT_URL="https://api.socialhub.yourdomain.com/auth/github/callback"

GMAIL_HOST="smtp.gmail.com"
GMAIL_PORT=587
GMAIL_USER="notifications@socialhub.yourdomain.com"
GMAIL_PASSWORD="your-secure-app-password"

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_production_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_production_cloudinary_upload_preset"
