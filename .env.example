###############################################################################
# Social_Hub Monorepo Environment Configuration (.env.example)
#
# IN DEV MODE:
#   Database and Redis use local Docker containers (docker-compose.dev.yml).
#
# IN PRODUCTION MODE:
#   Database and Redis connect to external managed resources (docker-compose.prod.yml).
###############################################################################

# ==============================================================================
# 1. DATABASE & REDIS
# ==============================================================================
# Development (Local Docker):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=socialhub
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socialhub?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_TLS="false"

# Production (External Managed Resources - AWS RDS/Supabase, Upstash/ElastiCache):
# DATABASE_URL="postgresql://prod_user:prod_password@aws-rds.endpoint.com:5432/socialhub_prod?sslmode=require"
# REDIS_URL="rediss://default:prod_password@redis-cloud.endpoint.com:6379"
# REDIS_TLS="true"
# REDIS_TLS_REJECT_UNAUTHORIZED="true"

# ==============================================================================
# 2. APPLICATION SERVERS & URLS
# ==============================================================================
PORT=5000
CLIENT_URL="http://localhost:3000"

NEXT_PUBLIC_API_URL="http://localhost:5000/graphql"
NEXT_PUBLIC_WS_URL="ws://localhost:5000/graphql"
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"

# ==============================================================================
# 3. SECURITY & TOKENS (Generate random 32+ char strings for production)
# ==============================================================================
ACCESS_TOKEN_SECRET="generate_random_32_character_string_for_access_token_secret"
REFRESH_TOKEN_SECRET="generate_random_32_character_string_for_refresh_token_secret"

# ==============================================================================
# 4. OAUTH PROVIDERS
# ==============================================================================
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URL="http://localhost:5000/auth/google/callback"

GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_REDIRECT_URL="http://localhost:5000/auth/github/callback"

# ==============================================================================
# 5. SMTP / EMAIL NOTIFICATIONS
# ==============================================================================
GMAIL_HOST="smtp.gmail.com"
GMAIL_PORT=587
GMAIL_USER="your-email@gmail.com"
GMAIL_PASSWORD="your-google-app-password"

# ==============================================================================
# 6. CLOUDINARY FILE UPLOADS
# ==============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_cloudinary_upload_preset"
